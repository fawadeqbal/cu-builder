{
  "name": "cv-builder",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=20",
    "dev:web": "turbo run dev --filter=@cvb/web...",
    "dev:api": "turbo run dev --filter=@cvb/api... --filter=@cvb/worker... --concurrency=20",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @cvb/db db:generate",
    "db:migrate": "pnpm --filter @cvb/db db:migrate",
    "db:deploy": "pnpm --filter @cvb/db db:deploy",
    "db:seed": "pnpm --filter @cvb/db db:seed",
    "db:seed:analytics": "pnpm --filter @cvb/db db:seed:analytics",
    "db:studio": "pnpm --filter @cvb/db db:studio",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,yml}\""
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
