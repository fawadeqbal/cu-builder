// Phase 1 schema: accounts (Better Auth), resumes with versions, share links, imports,
// billing, template settings and product analytics.
// Tables and columns are snake_case in Postgres, camelCase in TypeScript.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  STANDARD
  PREMIUM
  EXECUTIVE
}

enum PageSize {
  A4
  LETTER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum BillingProvider {
  STRIPE
  LOCAL
}

enum PassKind {
  DAYS_7
  DAYS_30
}

// ---------------------------------------------------------------- Accounts (Better Auth)
// Model and field names follow Better Auth's schema (core + admin plugin).

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false) @map("email_verified")
  image            String?
  /// Base plan granted by an admin or a promotion; subscriptions and passes can raise it.
  plan             Plan      @default(FREE)
  locale           String    @default("en")
  /// "user" or "admin" (Better Auth admin plugin).
  role             String?   @default("user")
  banned           Boolean?  @default(false)
  banReason        String?   @map("ban_reason")
  banExpires       DateTime? @map("ban_expires")
  stripeCustomerId String?   @unique @map("stripe_customer_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  sessions      Session[]
  accounts      Account[]
  resumes       Resume[]
  imports       ResumeImport[]
  subscriptions Subscription[]
  passes        Pass[]
  credits       CreditLedger[]

  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  token          String   @unique
  expiresAt      DateTime @map("expires_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A sign-in method: "credential" (email + password) or an OAuth provider.
model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Email verification, magic-link and password-reset tokens.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------- Resumes

model Resume {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  title      String
  templateId String    @default("classic") @map("template_id")
  accent     String?
  pageSize   PageSize  @default(A4) @map("page_size")
  /// The CV document; shape validated by @cvb/contracts ResumeDataSchema.
  data       Json
  archivedAt DateTime? @map("archived_at")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions     ResumeVersion[]
  shareLinks   ShareLink[]
  importedFrom ResumeImport?

  @@index([userId, updatedAt(sort: Desc)])
  @@map("resumes")
}

model ResumeVersion {
  id         String   @id @default(cuid())
  resumeId   String   @map("resume_id")
  data       Json
  templateId String   @map("template_id")
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt(sort: Desc)])
  @@map("resume_versions")
}

model ShareLink {
  id           String    @id @default(cuid())
  resumeId     String    @map("resume_id")
  slug         String    @unique
  enabled      Boolean   @default(true)
  passwordHash String?   @map("password_hash")
  expiresAt    DateTime? @map("expires_at")
  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("share_links")
}

enum ImportStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

/// An uploaded CV file being turned into a resume by the worker.
model ResumeImport {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  fileKey   String       @map("file_key")
  fileName  String       @map("file_name")
  mimeType  String       @map("mime_type")
  status    ImportStatus @default(QUEUED)
  error     String?
  /// Fields the parser was unsure about, for the review screen.
  warnings  Json?
  resumeId  String?      @unique @map("resume_id")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("resume_imports")
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String             @map("user_id")
  plan              Plan
  status            SubscriptionStatus
  provider          BillingProvider
  providerRef       String             @unique @map("provider_ref")
  currentPeriodEnd  DateTime           @map("current_period_end")
  cancelAtPeriodEnd Boolean            @default(false) @map("cancel_at_period_end")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

/// Payment-provider webhook events already applied; makes webhook handling idempotent.
model BillingEvent {
  id          String          @id
  provider    BillingProvider
  type        String
  processedAt DateTime        @default(now()) @map("processed_at")

  @@map("billing_events")
}

/// A one-time job-hunt pass (7 or 30 days of a plan).
model Pass {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  kind        PassKind
  plan        Plan
  startsAt    DateTime        @map("starts_at")
  endsAt      DateTime        @map("ends_at")
  provider    BillingProvider
  providerRef String?         @unique @map("provider_ref")
  createdAt   DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endsAt])
  @@map("passes")
}

/// Append-only AI credit movements; the balance is the sum of `delta`.
model CreditLedger {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  delta     Int
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_ledger")
}

// ---------------------------------------------------------------- Admin and analytics

/// Admin overrides for the template catalog (hide a template, move it to another tier, reorder).
model TemplateSetting {
  templateId String   @id @map("template_id")
  enabled    Boolean  @default(true)
  tier       String?
  sortOrder  Int?     @map("sort_order")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("template_settings")
}

/// Privacy-friendly product events: an anonymous id, no personal data in `props`.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  name        String
  anonymousId String   @map("anonymous_id")
  userId      String?  @map("user_id")
  props       Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([name, createdAt])
  @@map("analytics_events")
}
