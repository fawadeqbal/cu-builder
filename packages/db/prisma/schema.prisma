// Phase 1 schema: accounts (Better Auth), resumes with versions, share links, imports,
// billing, template settings and product analytics.
// Tables and columns are snake_case in Postgres, camelCase in TypeScript.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  STANDARD
  PREMIUM
  EXECUTIVE
}

enum PageSize {
  A4
  LETTER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum BillingProvider {
  STRIPE
  LOCAL
}

enum PassKind {
  DAYS_7
  DAYS_30
}

// ---------------------------------------------------------------- Accounts (Better Auth)
// Model and field names follow Better Auth's schema (core + admin plugin).

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false) @map("email_verified")
  image            String?
  /// Base plan granted by an admin or a promotion; subscriptions and passes can raise it.
  plan             Plan      @default(FREE)
  locale           String    @default("en")
  /// "user" or "admin" (Better Auth admin plugin).
  role             String?   @default("user")
  banned           Boolean?  @default(false)
  banReason        String?   @map("ban_reason")
  banExpires       DateTime? @map("ban_expires")
  stripeCustomerId String?   @unique @map("stripe_customer_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  sessions      Session[]
  accounts      Account[]
  resumes       Resume[]
  imports       ResumeImport[]
  subscriptions Subscription[]
  passes        Pass[]
  credits       CreditLedger[]
  jobs          Job[]
  matches       Match[]
  coverLetters  CoverLetter[]
  applications  Application[]
  reminders     Reminder[]
  tracker       TrackerBoard?
  jobPrefs      JobPreferences?
  interviews    InterviewSession[]
  stories       StarStory[]
  apiTokens     ApiToken[]

  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  token          String   @unique
  expiresAt      DateTime @map("expires_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A sign-in method: "credential" (email + password) or an OAuth provider.
model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Email verification, magic-link and password-reset tokens.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------- Resumes

model Resume {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  title        String
  templateId   String    @default("classic") @map("template_id")
  accent       String?
  pageSize     PageSize  @default(A4) @map("page_size")
  /// The CV document; shape validated by @cvb/contracts ResumeDataSchema.
  data         Json
  /// Presentation settings that aren't content, e.g. { fontScale } from "Fit to one page".
  style        Json?
  /// Set on tailored copies: the CV it was made from and the job it targets.
  baseResumeId String?   @map("base_resume_id")
  jobId        String?   @map("job_id")
  archivedAt   DateTime? @map("archived_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions     ResumeVersion[]
  shareLinks   ShareLink[]
  importedFrom ResumeImport?
  base         Resume?         @relation("Tailored", fields: [baseResumeId], references: [id], onDelete: SetNull)
  tailored     Resume[]        @relation("Tailored")
  job          Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  matches      Match[]
  coverLetters CoverLetter[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("resumes")
}

model ResumeVersion {
  id         String   @id @default(cuid())
  resumeId   String   @map("resume_id")
  data       Json
  templateId String   @map("template_id")
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt(sort: Desc)])
  @@map("resume_versions")
}

model ShareLink {
  id             String    @id @default(cuid())
  resumeId       String    @map("resume_id")
  slug           String    @unique
  enabled        Boolean   @default(true)
  passwordHash   String?   @map("password_hash")
  expiresAt      DateTime? @map("expires_at")
  viewCount      Int       @default(0) @map("view_count")
  lastViewedAt   DateTime? @map("last_viewed_at")
  /// Who the link was made for ("Acme application"), so the owner sees which employer opened it.
  label          String?
  /// Email the owner when someone opens it (at most once an hour).
  notifyOnView   Boolean   @default(true) @map("notify_on_view")
  lastNotifiedAt DateTime? @map("last_notified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  resume       Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  views        LinkView[]
  applications Application[]

  @@index([resumeId])
  @@map("share_links")
}

enum ImportStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

/// An uploaded CV file being turned into a resume by the worker.
model ResumeImport {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  fileKey   String       @map("file_key")
  fileName  String       @map("file_name")
  mimeType  String       @map("mime_type")
  status    ImportStatus @default(QUEUED)
  error     String?
  /// Fields the parser was unsure about, for the review screen.
  warnings  Json?
  resumeId  String?      @unique @map("resume_id")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("resume_imports")
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String             @map("user_id")
  plan              Plan
  status            SubscriptionStatus
  provider          BillingProvider
  providerRef       String             @unique @map("provider_ref")
  currentPeriodEnd  DateTime           @map("current_period_end")
  cancelAtPeriodEnd Boolean            @default(false) @map("cancel_at_period_end")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

/// Payment-provider webhook events already applied; makes webhook handling idempotent.
model BillingEvent {
  id          String          @id
  provider    BillingProvider
  type        String
  processedAt DateTime        @default(now()) @map("processed_at")

  @@map("billing_events")
}

/// A one-time job-hunt pass (7 or 30 days of a plan).
model Pass {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  kind        PassKind
  plan        Plan
  startsAt    DateTime        @map("starts_at")
  endsAt      DateTime        @map("ends_at")
  provider    BillingProvider
  providerRef String?         @unique @map("provider_ref")
  createdAt   DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endsAt])
  @@map("passes")
}

/// Append-only AI credit movements; the balance is the sum of `delta`.
model CreditLedger {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  delta     Int
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_ledger")
}

// ---------------------------------------------------------------- Admin and analytics

/// Admin overrides for the template catalog (hide a template, move it to another tier, reorder).
model TemplateSetting {
  templateId String   @id @map("template_id")
  enabled    Boolean  @default(true)
  tier       String?
  sortOrder  Int?     @map("sort_order")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("template_settings")
}

/// Privacy-friendly product events: an anonymous id, no personal data in `props`.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  name        String
  anonymousId String   @map("anonymous_id")
  userId      String?  @map("user_id")
  props       Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([name, createdAt])
  @@map("analytics_events")
}

// ---------------------------------------------------------------- Phase 2: resume intelligence

/// A job the user is targeting: pasted, read from a link, saved by the extension or the feed.
model Job {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  title       String
  company     String    @default("")
  location    String    @default("")
  url         String?
  description String    @default("")
  /// manual | link | extension | feed
  source      String    @default("manual")
  /// The provider's id for feed jobs, to avoid saving the same posting twice.
  externalId  String?   @map("external_id")
  salary      String    @default("")
  remote      Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches      Match[]
  tailored     Resume[]
  coverLetters CoverLetter[]
  applications Application[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("jobs")
}

/// The latest match result of a CV against a job (keywords, score, seniority).
model Match {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  resumeId  String   @map("resume_id")
  jobId     String   @map("job_id")
  score     Int
  result    Json
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([resumeId, jobId])
  @@map("matches")
}

model CoverLetter {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  resumeId     String?   @map("resume_id")
  jobId        String?   @map("job_id")
  title        String
  templateId   String    @default("classic") @map("template_id")
  accent       String?
  pageSize     PageSize  @default(A4) @map("page_size")
  /// { recipient, company, date, greeting, paragraphs[], closing, signature }
  data         Json
  shareSlug    String?   @unique @map("share_slug")
  shareEnabled Boolean   @default(false) @map("share_enabled")
  viewCount    Int       @default(0) @map("view_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  job    Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt(sort: Desc)])
  @@map("cover_letters")
}

// ---------------------------------------------------------------- Phase 3: job search tools

/// One job in the tracker: where it is in the process and everything used for it.
model Application {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  jobId         String    @map("job_id")
  /// Column key on the board (customisable per user, see TrackerBoard).
  status        String    @default("saved")
  /// Order inside a column (fractional so a move updates one row).
  position      Float     @default(0)
  resumeId      String?   @map("resume_id")
  coverLetterId String?   @map("cover_letter_id")
  shareLinkId   String?   @map("share_link_id")
  salaryMin     Int?      @map("salary_min")
  salaryMax     Int?      @map("salary_max")
  currency      String?
  /// [{ name, role, email, phone }]
  contacts      Json      @default("[]")
  notes         String    @default("")
  /// { values, links[], questionsToAsk[], notes }
  research      Json      @default("{}")
  /// { baseSalary, currency, bonus, equity, benefits, location, remote, growth, deadline, notes }
  offer         Json?
  appliedAt     DateTime? @map("applied_at")
  interviewAt   DateTime? @map("interview_at")
  deadlineAt    DateTime? @map("deadline_at")
  /// Remind to follow up this many days after applying.
  followUpDays  Int?      @map("follow_up_days")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  shareLink ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  reminders Reminder[]

  @@index([userId, status, position])
  @@map("applications")
}

/// The user's board columns, in order: [{ key, label }].
model TrackerBoard {
  userId    String   @id @map("user_id")
  columns   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tracker_boards")
}

model Reminder {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  applicationId String?   @map("application_id")
  /// follow_up | interview | deadline | custom
  kind          String
  title         String
  dueAt         DateTime  @map("due_at")
  doneAt        DateTime? @map("done_at")
  notifiedAt    DateTime? @map("notified_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([dueAt, notifiedAt])
  @@index([userId, dueAt])
  @@map("reminders")
}

/// What the job feed looks for, and how often to email new matches.
model JobPreferences {
  userId      String    @id @map("user_id")
  titles      String[]
  location    String    @default("")
  remote      Boolean   @default(false)
  salaryMin   Int?      @map("salary_min")
  /// off | daily | weekly
  alerts      String    @default("off")
  lastAlertAt DateTime? @map("last_alert_at")
  /// The Monday progress email (on by default while there are active applications).
  weeklyDigest Boolean  @default(true) @map("weekly_digest")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("job_preferences")
}

/// A mock interview: questions, answers and AI feedback per answer.
model InterviewSession {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  role        String
  seniority   String    @default("")
  jobId       String?   @map("job_id")
  /// [{ question, competency, tip }]
  questions   Json
  /// [{ index, answer, scores, feedback, improved }]
  answers     Json      @default("[]")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("interview_sessions")
}

/// A Situation-Task-Action-Result story, saved for reuse in interviews.
model StarStory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  title        String
  situation    String   @default("")
  task         String   @default("")
  action       String   @default("")
  result       String   @default("")
  sourceBullet String   @default("") @map("source_bullet")
  tags         String[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@map("star_stories")
}

/// One open of a share link: for view analytics (no raw IPs stored).
model LinkView {
  id          String   @id @default(cuid())
  shareLinkId String   @map("share_link_id")
  /// Hash of IP + user agent + day, to count unique viewers without storing who they are.
  visitor     String
  referrer    String?
  country     String?
  device      String?
  durationMs  Int      @default(0) @map("duration_ms")
  downloaded  Boolean  @default(false)
  viewedAt    DateTime @default(now()) @map("viewed_at")

  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([shareLinkId, viewedAt(sort: Desc)])
  @@map("link_views")
}

/// Personal access tokens (the browser extension). Only a hash is stored.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String
  prefix     String
  tokenHash  String    @unique @map("token_hash")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}
