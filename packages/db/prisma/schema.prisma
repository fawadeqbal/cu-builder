// Phase 1 schema: accounts (Better Auth), resumes with versions, share links, imports,
// billing, template settings and product analytics.
// Tables and columns are snake_case in Postgres, camelCase in TypeScript.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  STANDARD
  PREMIUM
  EXECUTIVE
}

enum PageSize {
  A4
  LETTER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum BillingProvider {
  STRIPE
  LOCAL
}

enum PassKind {
  DAYS_7
  DAYS_30
}

// ---------------------------------------------------------------- Accounts (Better Auth)
// Model and field names follow Better Auth's schema (core + admin plugin).

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false) @map("email_verified")
  image            String?
  /// Base plan granted by an admin or a promotion; subscriptions and passes can raise it.
  plan             Plan      @default(FREE)
  locale           String    @default("en")
  /// "user" or "admin" (Better Auth admin plugin).
  role             String?   @default("user")
  banned           Boolean?  @default(false)
  banReason        String?   @map("ban_reason")
  banExpires       DateTime? @map("ban_expires")
  stripeCustomerId String?   @unique @map("stripe_customer_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  sessions      Session[]
  accounts      Account[]
  resumes       Resume[]
  imports       ResumeImport[]
  subscriptions Subscription[]
  passes        Pass[]
  credits       CreditLedger[]
  jobs          Job[]
  matches       Match[]
  coverLetters  CoverLetter[]
  applications  Application[]
  reminders     Reminder[]
  tracker       TrackerBoard?
  jobPrefs      JobPreferences?
  interviews    InterviewSession[]
  stories       StarStory[]
  apiTokens     ApiToken[]
  expert        ExpertProfile?
  orders        ServiceOrder[]     @relation("BuyerOrders")
  orderMessages OrderMessage[]
  comments      ReviewComment[]
  memberships   Membership[]
  candidates    Candidate[]
  portfolio     PortfolioSite?
  talentProfile TalentProfile?
  talentContacts TalentContact[]
  review        Review?

  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  token          String   @unique
  expiresAt      DateTime @map("expires_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A sign-in method: "credential" (email + password) or an OAuth provider.
model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Email verification, magic-link and password-reset tokens.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------- Resumes

model Resume {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  title        String
  templateId   String    @default("classic") @map("template_id")
  accent       String?
  pageSize     PageSize  @default(A4) @map("page_size")
  /// The CV document; shape validated by @cvb/contracts ResumeDataSchema.
  data         Json
  /// Presentation settings that aren't content, e.g. { fontScale } from "Fit to one page".
  style        Json?
  /// Set on tailored copies: the CV it was made from and the job it targets.
  baseResumeId String?   @map("base_resume_id")
  jobId        String?   @map("job_id")
  archivedAt   DateTime? @map("archived_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions     ResumeVersion[]
  shareLinks   ShareLink[]
  importedFrom ResumeImport?
  base         Resume?         @relation("Tailored", fields: [baseResumeId], references: [id], onDelete: SetNull)
  tailored     Resume[]        @relation("Tailored")
  job          Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  matches      Match[]
  coverLetters CoverLetter[]
  orders       ServiceOrder[]
  comments     ReviewComment[]
  portfolios   PortfolioSite[]
  talentProfiles TalentProfile[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("resumes")
}

model ResumeVersion {
  id         String   @id @default(cuid())
  resumeId   String   @map("resume_id")
  data       Json
  templateId String   @map("template_id")
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt(sort: Desc)])
  @@map("resume_versions")
}

model ShareLink {
  id             String    @id @default(cuid())
  resumeId       String    @map("resume_id")
  slug           String    @unique
  enabled        Boolean   @default(true)
  passwordHash   String?   @map("password_hash")
  expiresAt      DateTime? @map("expires_at")
  viewCount      Int       @default(0) @map("view_count")
  lastViewedAt   DateTime? @map("last_viewed_at")
  /// Who the link was made for ("Acme application"), so the owner sees which employer opened it.
  label          String?
  /// Email the owner when someone opens it (at most once an hour).
  notifyOnView   Boolean   @default(true) @map("notify_on_view")
  lastNotifiedAt DateTime? @map("last_notified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  resume       Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  views        LinkView[]
  applications Application[]

  @@index([resumeId])
  @@map("share_links")
}

enum ImportStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

/// An uploaded CV file being turned into a resume by the worker.
model ResumeImport {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  fileKey   String       @map("file_key")
  fileName  String       @map("file_name")
  mimeType  String       @map("mime_type")
  status    ImportStatus @default(QUEUED)
  error     String?
  /// Fields the parser was unsure about, for the review screen.
  warnings  Json?
  resumeId  String?      @unique @map("resume_id")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("resume_imports")
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String             @map("user_id")
  plan              Plan
  status            SubscriptionStatus
  provider          BillingProvider
  providerRef       String             @unique @map("provider_ref")
  currentPeriodEnd  DateTime           @map("current_period_end")
  cancelAtPeriodEnd Boolean            @default(false) @map("cancel_at_period_end")
  /// Billing currency ("usd", "pkr").
  currency          String             @default("usd")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

/// Payment-provider webhook events already applied; makes webhook handling idempotent.
model BillingEvent {
  id          String          @id
  provider    BillingProvider
  type        String
  /// For payments: the amount (minor units) and currency charged.
  amountCents Int?            @map("amount_cents")
  currency    String?
  processedAt DateTime        @default(now()) @map("processed_at")

  @@map("billing_events")
}

/// A one-time job-hunt pass (7 or 30 days of a plan).
model Pass {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  kind        PassKind
  plan        Plan
  startsAt    DateTime        @map("starts_at")
  endsAt      DateTime        @map("ends_at")
  provider    BillingProvider
  providerRef String?         @unique @map("provider_ref")
  /// What was paid, in the currency's minor unit.
  amountCents Int?            @map("amount_cents")
  currency    String          @default("usd")
  createdAt   DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endsAt])
  @@map("passes")
}

/// Append-only AI credit movements; the balance is the sum of `delta`.
model CreditLedger {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  delta     Int
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_ledger")
}

// ---------------------------------------------------------------- Admin and analytics

/// Admin overrides for the template catalog (hide a template, move it to another tier, reorder).
model TemplateSetting {
  templateId String   @id @map("template_id")
  enabled    Boolean  @default(true)
  tier       String?
  sortOrder  Int?     @map("sort_order")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("template_settings")
}

/// Admin price overrides per offer and currency; defaults live in @cvb/domain (DEFAULT_PRICES).
model PriceSetting {
  offerId   String   @map("offer_id")
  /// "usd" | "pkr"
  currency  String
  /// Minor units (cents, paisa).
  amount    Int
  updatedAt DateTime @updatedAt @map("updated_at")
  /// The admin who set it (user id; kept if that account goes).
  updatedBy String?  @map("updated_by")

  @@id([offerId, currency])
  @@map("price_settings")
}

/// Privacy-friendly product events: an anonymous id, no personal data in `props`.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  name        String
  anonymousId String   @map("anonymous_id")
  userId      String?  @map("user_id")
  props       Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([name, createdAt])
  @@map("analytics_events")
}

// ---------------------------------------------------------------- Phase 2: resume intelligence

/// A job the user is targeting: pasted, read from a link, saved by the extension or the feed.
model Job {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  title       String
  company     String    @default("")
  location    String    @default("")
  url         String?
  description String    @default("")
  /// manual | link | extension | feed
  source      String    @default("manual")
  /// The provider's id for feed jobs, to avoid saving the same posting twice.
  externalId  String?   @map("external_id")
  salary      String    @default("")
  remote      Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches      Match[]
  tailored     Resume[]
  coverLetters CoverLetter[]
  applications Application[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("jobs")
}

/// The latest match result of a CV against a job (keywords, score, seniority).
model Match {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  resumeId  String   @map("resume_id")
  jobId     String   @map("job_id")
  score     Int
  result    Json
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([resumeId, jobId])
  @@map("matches")
}

model CoverLetter {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  resumeId     String?   @map("resume_id")
  jobId        String?   @map("job_id")
  title        String
  templateId   String    @default("classic") @map("template_id")
  accent       String?
  pageSize     PageSize  @default(A4) @map("page_size")
  /// { recipient, company, date, greeting, paragraphs[], closing, signature }
  data         Json
  shareSlug    String?   @unique @map("share_slug")
  shareEnabled Boolean   @default(false) @map("share_enabled")
  viewCount    Int       @default(0) @map("view_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  job    Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt(sort: Desc)])
  @@map("cover_letters")
}

// ---------------------------------------------------------------- Phase 3: job search tools

/// One job in the tracker: where it is in the process and everything used for it.
model Application {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  jobId         String    @map("job_id")
  /// Column key on the board (customisable per user, see TrackerBoard).
  status        String    @default("saved")
  /// Order inside a column (fractional so a move updates one row).
  position      Float     @default(0)
  resumeId      String?   @map("resume_id")
  coverLetterId String?   @map("cover_letter_id")
  shareLinkId   String?   @map("share_link_id")
  salaryMin     Int?      @map("salary_min")
  salaryMax     Int?      @map("salary_max")
  currency      String?
  /// [{ name, role, email, phone }]
  contacts      Json      @default("[]")
  notes         String    @default("")
  /// { values, links[], questionsToAsk[], notes }
  research      Json      @default("{}")
  /// { baseSalary, currency, bonus, equity, benefits, location, remote, growth, deadline, notes }
  offer         Json?
  appliedAt     DateTime? @map("applied_at")
  interviewAt   DateTime? @map("interview_at")
  deadlineAt    DateTime? @map("deadline_at")
  /// Remind to follow up this many days after applying.
  followUpDays  Int?      @map("follow_up_days")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  shareLink ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  reminders Reminder[]

  @@index([userId, status, position])
  @@map("applications")
}

/// The user's board columns, in order: [{ key, label }].
model TrackerBoard {
  userId    String   @id @map("user_id")
  columns   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tracker_boards")
}

model Reminder {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  applicationId String?   @map("application_id")
  /// follow_up | interview | deadline | custom
  kind          String
  title         String
  dueAt         DateTime  @map("due_at")
  doneAt        DateTime? @map("done_at")
  notifiedAt    DateTime? @map("notified_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([dueAt, notifiedAt])
  @@index([userId, dueAt])
  @@map("reminders")
}

/// What the job feed looks for, and how often to email new matches.
model JobPreferences {
  userId       String    @id @map("user_id")
  titles       String[]
  location     String    @default("")
  remote       Boolean   @default(false)
  salaryMin    Int?      @map("salary_min")
  /// off | daily | weekly
  alerts       String    @default("off")
  lastAlertAt  DateTime? @map("last_alert_at")
  /// The Monday progress email (on by default while there are active applications).
  weeklyDigest Boolean   @default(true) @map("weekly_digest")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("job_preferences")
}

/// A mock interview: questions, answers and AI feedback per answer.
model InterviewSession {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  role        String
  seniority   String    @default("")
  jobId       String?   @map("job_id")
  /// [{ question, competency, tip }]
  questions   Json
  /// [{ index, answer, scores, feedback, improved }]
  answers     Json      @default("[]")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("interview_sessions")
}

/// A Situation-Task-Action-Result story, saved for reuse in interviews.
model StarStory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  title        String
  situation    String   @default("")
  task         String   @default("")
  action       String   @default("")
  result       String   @default("")
  sourceBullet String   @default("") @map("source_bullet")
  tags         String[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@map("star_stories")
}

/// One open of a share link: for view analytics (no raw IPs stored).
model LinkView {
  id          String   @id @default(cuid())
  shareLinkId String   @map("share_link_id")
  /// Hash of IP + user agent + day, to count unique viewers without storing who they are.
  visitor     String
  referrer    String?
  country     String?
  device      String?
  durationMs  Int      @default(0) @map("duration_ms")
  downloaded  Boolean  @default(false)
  viewedAt    DateTime @default(now()) @map("viewed_at")

  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@index([shareLinkId, viewedAt(sort: Desc)])
  @@map("link_views")
}

/// Personal access tokens (the browser extension). Only a hash is stored.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String
  prefix     String
  tokenHash  String    @unique @map("token_hash")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

// ─── Phase 4: services and scale ────────────────────────────────────────────

/// An expert who sells CV reviews, CV writing, coaching or LinkedIn makeovers.
model ExpertProfile {
  userId          String    @id @map("user_id")
  displayName     String    @map("display_name")
  headline        String    @default("")
  bio             String    @default("")
  photoUrl        String?   @map("photo_url")
  specialties     String[]
  languages       String[]
  /// review | writing | coaching | linkedin
  services        String[]
  /// pending | approved | suspended
  status          String    @default("pending")
  timezone        String    @default("UTC")
  /// Weekly coaching availability in `timezone`: [{ day: 0-6, start: "09:00", end: "17:00" }].
  availability    Json      @default("[]")
  maxActiveOrders Int       @default(5) @map("max_active_orders")
  /// Stripe Connect (Express) account for payouts.
  stripeAccountId String?   @unique @map("stripe_account_id")
  payoutsEnabled  Boolean   @default(false) @map("payouts_enabled")
  ratingAvg       Float     @default(0) @map("rating_avg")
  ratingCount     Int       @default(0) @map("rating_count")
  approvedAt      DateTime? @map("approved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders ServiceOrder[] @relation("ExpertOrders")

  @@index([status, ratingAvg(sort: Desc)])
  @@map("expert_profiles")
}

/// A purchased (or plan-included) expert service.
model ServiceOrder {
  id                String    @id @default(cuid())
  /// The buyer.
  userId            String    @map("user_id")
  expertId          String?   @map("expert_id")
  /// review | review_rush | writing | coaching | linkedin
  kind              String
  /// pending_payment | paid | in_progress | delivered | completed | cancelled | refunded | disputed
  status            String    @default("pending_payment")
  resumeId          String?   @map("resume_id")
  priceCents        Int       @map("price_cents")
  currency          String    @default("usd")
  /// The platform's share; the expert is paid the rest on completion.
  commissionCents   Int       @default(0) @map("commission_cents")
  /// Included in the plan (Executive review) rather than paid for.
  included          Boolean   @default(false)
  /// Intake questionnaire answers, coaching goals.
  intake            Json      @default("{}")
  dueAt             DateTime? @map("due_at")
  scheduledAt       DateTime? @map("scheduled_at")
  durationMin       Int?      @map("duration_min")
  meetingUrl        String?   @map("meeting_url")
  /// The expert's delivery summary, or coaching session notes.
  deliveryNote      String    @default("") @map("delivery_note")
  revisionsIncluded Int       @default(0) @map("revisions_included")
  revisionsUsed     Int       @default(0) @map("revisions_used")
  rating            Int?
  ratingComment     String    @default("") @map("rating_comment")
  checkoutId        String?   @unique @map("checkout_id")
  paymentId         String?   @map("payment_id")
  refundId          String?   @map("refund_id")
  transferId        String?   @map("transfer_id")
  refundReason      String    @default("") @map("refund_reason")
  /// { reason, openedAt, resolution?, resolvedAt? }
  dispute           Json?
  paidAt            DateTime? @map("paid_at")
  assignedAt        DateTime? @map("assigned_at")
  deliveredAt       DateTime? @map("delivered_at")
  completedAt       DateTime? @map("completed_at")
  cancelledAt       DateTime? @map("cancelled_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user     User            @relation("BuyerOrders", fields: [userId], references: [id], onDelete: Cascade)
  expert   ExpertProfile?  @relation("ExpertOrders", fields: [expertId], references: [userId], onDelete: SetNull)
  resume   Resume?         @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  messages OrderMessage[]
  comments ReviewComment[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([expertId, status])
  @@index([status, dueAt])
  @@map("service_orders")
}

/// Messages on an order (questions, drafts, revision requests).
model OrderMessage {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  authorId    String   @map("author_id")
  body        String
  /// [{ key, name, size }] files in storage (drafts).
  attachments Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")

  order  ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_messages")
}

/// A comment on one line of a CV, by an expert or a career-office reviewer.
model ReviewComment {
  id         String    @id @default(cuid())
  resumeId   String    @map("resume_id")
  authorId   String    @map("author_id")
  orderId    String?   @map("order_id")
  orgId      String?   @map("org_id")
  /// Where in the CV: "summary", "personal.headline", "experience.<itemId>.bullets.2"…
  anchor     String
  /// The text commented on, as it was.
  quote      String    @default("")
  body       String
  /// Replacement text the owner can apply in one click.
  suggestion String?
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  resume Resume        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  order  ServiceOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  org    Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([resumeId, createdAt])
  @@map("review_comments")
}

/// A university, career centre, recruitment agency or white-label partner.
model Organization {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  /// university | agency | partner
  kind              String
  /// Seat licences; members holding a seat get `seatPlan`.
  seats             Int       @default(0)
  seatPlan          Plan      @default(PREMIUM) @map("seat_plan")
  /// The branded sign-up link: /join/<inviteCode>.
  inviteCode        String    @unique @map("invite_code")
  /// Email domains whose people may join with Google or Microsoft sign-in (e.g. "uni.edu.pk").
  ssoDomains        String[]  @map("sso_domains")
  /// White label: { productName, logoUrl, primaryColor, accentColor, templateIds, hideBrand }.
  branding          Json      @default("{}")
  customDomain      String?   @unique @map("custom_domain")
  domainVerifiedAt  DateTime? @map("domain_verified_at")
  /// Agencies: the template candidate CVs are reformatted into.
  defaultTemplateId String?   @map("default_template_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  members    Membership[]
  invites    OrgInvite[]
  candidates Candidate[]
  comments   ReviewComment[]
  talentContacts TalentContact[]

  @@map("organizations")
}

model Membership {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  userId    String   @map("user_id")
  /// owner | admin | reviewer | recruiter | member
  role      String   @default("member")
  cohort    String   @default("")
  /// Holds a seat licence (gives the organisation's seat plan).
  seat      Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

model OrgInvite {
  id         String    @id @default(cuid())
  orgId      String    @map("org_id")
  email      String
  role       String    @default("member")
  cohort     String    @default("")
  token      String    @unique
  acceptedAt DateTime? @map("accepted_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@map("org_invites")
}

/// An agency's candidate CV: uploaded in bulk, parsed, reformatted in the agency template.
model Candidate {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  createdById   String   @map("created_by_id")
  /// One bulk upload.
  batchId       String   @default("") @map("batch_id")
  name          String   @default("")
  /// queued | parsing | ready | failed
  status        String   @default("queued")
  fileKey       String   @default("") @map("file_key")
  fileName      String   @default("") @map("file_name")
  mimeType      String   @default("") @map("mime_type")
  /// The parsed CV (ResumeDataSchema).
  data          Json?
  /// Fields the parser was unsure of: [{ path, label, reason }].
  lowConfidence Json     @default("[]") @map("low_confidence")
  hideContacts  Boolean  @default(false) @map("hide_contacts")
  templateId    String?  @map("template_id")
  error         String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([batchId])
  @@map("candidates")
}

/// A personal website generated from a CV: <slug>.<PORTFOLIO_DOMAIN> or a custom domain.
model PortfolioSite {
  id               String    @id @default(cuid())
  userId           String    @unique @map("user_id")
  resumeId         String    @map("resume_id")
  slug             String    @unique
  customDomain     String?   @unique @map("custom_domain")
  domainVerifiedAt DateTime? @map("domain_verified_at")
  published        Boolean   @default(false)
  theme            String    @default("minimal")
  accent           String?
  showContactForm  Boolean   @default(true) @map("show_contact_form")
  /// Extra content not in the CV: { about, projects: [{ title, description, url, imageUrl }] }.
  content          Json      @default("{}")
  viewCount        Int       @default(0) @map("view_count")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume   Resume           @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  messages ContactMessage[]

  @@map("portfolio_sites")
}

/// A message sent through a portfolio site's contact form.
model ContactMessage {
  id        String    @id @default(cuid())
  siteId    String    @map("site_id")
  name      String
  email     String
  message   String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  site PortfolioSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt(sort: Desc)])
  @@map("contact_messages")
}

// ---------------------------------------------------------------- Talent search (opt-in)

/// "Let recruiters find me": what a job seeker chose to show agency recruiters.
model TalentProfile {
  id         String   @id @default(cuid())
  userId     String   @unique @map("user_id")
  /// The CV shown; null if it was deleted (then the profile is hidden until another is chosen).
  resumeId   String?  @map("resume_id")
  /// Off by default; switching off hides the profile at once.
  visible    Boolean  @default(false)
  headline   String
  location   String   @default("")
  /// Roles they're open to.
  roles      String[]
  /// full | summary
  share      String   @default("summary")
  /// Job titles and skills taken from the CV for search, refreshed when the CV changes.
  titles     String[]
  skills     String[]
  searchText String   @default("") @map("search_text")
  syncedAt   DateTime @default(now()) @map("synced_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume   Resume?         @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  contacts TalentContact[]

  @@index([visible, updatedAt(sort: Desc)])
  @@map("talent_profiles")
}

/// A recruiter's message to a talent profile, emailed through the platform. Also the rate-limit log.
model TalentContact {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  senderId  String   @map("sender_id")
  profileId String   @map("profile_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  org     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sender  User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  profile TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@index([orgId, profileId, createdAt])
  @@index([orgId, createdAt(sort: Desc)])
  @@map("talent_contacts")
}

// ---------------------------------------------------------------- Trust: reviews and site settings

/// A user's review of the product, shown on the landing page once a moderator approves it.
model Review {
  id          String    @id @default(cuid())
  /// One review per account; the author can edit it.
  userId      String    @unique @map("user_id")
  /// 1 to 5 stars.
  rating      Int
  /// Up to 600 characters.
  text        String
  displayName String    @map("display_name")
  jobTitle    String?   @map("job_title")
  /// "pending", "approved" or "rejected". New and edited reviews start as pending.
  status      String    @default("pending")
  moderatedAt DateTime? @map("moderated_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@map("reviews")
}

/// Site-wide settings managed in the admin console, one row per key (e.g. "whatsapp.number").
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
