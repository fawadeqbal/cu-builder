{
  "name": "@cvb/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Postgres schema, migrations and the Prisma client factory.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "import": "./dist/nest.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint src prisma",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo src/generated"
  },
  "dependencies": {
    "@cvb/domain": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@cvb/eslint-config": "workspace:*",
    "@cvb/tsconfig": "workspace:*",
    "@types/node": "22.20.5",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@nestjs/common": "12.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^12"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  }
}
