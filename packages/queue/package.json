{
  "name": "@cvb/queue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Background jobs: a JobProducer port, the BullMQ adapter and a Nest module shared by api and worker.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "import": "./dist/nest.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@cvb/eslint-config": "workspace:*",
    "@cvb/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@types/node": "22.20.5"
  },
  "dependencies": {
    "@cvb/contracts": "workspace:*",
    "bullmq": "6.3.11",
    "ioredis": "6.0.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@nestjs/bullmq": "^12",
    "@nestjs/common": "^12"
  },
  "peerDependenciesMeta": {
    "@nestjs/bullmq": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    }
  }
}
