{
  "name": "@cvb/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared React UI: icons and small presentational components (styled with Tailwind classes).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@cvb/eslint-config": "workspace:*",
    "@cvb/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@types/react": "^19",
    "react": "19.3.0"
  },
  "dependencies": {
    "@cvb/domain": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19"
  }
}
