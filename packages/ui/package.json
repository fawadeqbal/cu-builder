{
  "name": "@cvb/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The CV Builder design system (Folio): tokens, styles and React components shared by the apps.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./tokens.json": "./tokens.json",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "tokens.json",
    "fonts"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@cvb/eslint-config": "workspace:*",
    "@cvb/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@types/react": "^19",
    "react": "19.3.0",
    "@types/react-dom": "^19",
    "react-dom": "19.3.0"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
