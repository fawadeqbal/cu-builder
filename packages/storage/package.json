{
  "name": "@cvb/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "File storage behind a port: local disk today, S3-compatible later.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@cvb/eslint-config": "workspace:*",
    "@cvb/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@types/node": "22.20.5"
  },
  "dependencies": {}
}
