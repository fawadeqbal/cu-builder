{
  "name": "@cvb/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HTTP API (NestJS): accounts, resumes, billing. Business rules come from @cvb/domain.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch --exec \"node --enable-source-maps --env-file-if-exists=../../.env\"",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@cvb/config": "workspace:*",
    "@cvb/contracts": "workspace:*",
    "@cvb/db": "workspace:*",
    "@cvb/domain": "workspace:*",
    "@cvb/extract": "workspace:*",
    "@cvb/jobfeed": "workspace:*",
    "@cvb/queue": "workspace:*",
    "@cvb/shared": "workspace:*",
    "@cvb/storage": "workspace:*",
    "@cvb/templates": "workspace:*",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/throttler": "6.7.1",
    "better-auth": "1.7.7",
    "bullmq": "6.3.11",
    "express": "5.2.1",
    "fflate": "0.8.3",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "23.0.0",
    "zod": "4.6.5",
    "@cvb/ai": "workspace:*"
  },
  "devDependencies": {
    "@cvb/eslint-config": "workspace:*",
    "@cvb/tsconfig": "workspace:*",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.3",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "4.1.11"
  }
}
