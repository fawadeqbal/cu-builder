# Copy to .env at the repo root: cp .env.example .env
NODE_ENV=development

# Postgres (docker compose) — used by packages/db, apps/api, apps/worker
DATABASE_URL=postgresql://cvb:cvb@localhost:5432/cvb?schema=public

# Redis (docker compose) — BullMQ queues
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000

# Development-only sign-in: lets requests act as a user via the x-dev-user header.
# Refused when NODE_ENV=production. Replaced by real auth in Phase 1.
DEV_AUTH=true

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
