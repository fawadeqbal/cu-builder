# Copy to .env at the repo root: cp .env.example .env
NODE_ENV=development

# Postgres (docker compose) — used by packages/db, apps/api, apps/worker
DATABASE_URL=postgresql://cvb:cvb@localhost:5432/cvb?schema=public

# Redis (docker compose) — BullMQ queues
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000

# Development-only: lets scripts act as a user with the x-dev-user header.
# Ignored when NODE_ENV=production. People sign in through Better Auth either way.
DEV_AUTH=true

# Web: the browser calls /api on the web's own origin; the Next server forwards it here.
# (In production Caddy routes /api straight to the API.)
API_INTERNAL_URL=http://localhost:4000

# Public URL of the web app. The API is served behind it at /api (same domain, same cookies).
APP_URL=http://localhost:3000

# Better Auth: at least 32 random characters (openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
# Comma-separated emails that become admins on sign-up
ADMIN_EMAILS=

# Social sign-in (optional; buttons appear only when set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Stripe (optional; checkout is disabled without it). Use test keys locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Uploaded files (CV imports), shared by api and worker. Relative paths start in apps/<app>,
# so this points both at <repo>/.storage. On the VPS it is a Docker volume.
STORAGE_DIR=../../.storage

# Email: smtp://user:pass@host:587. Without it the worker logs emails instead of sending.
SMTP_URL=
EMAIL_FROM="CV Builder <no-reply@example.com>"
