# Copy to infra/.env.production on the server and fill in. Never commit the real file.

# --- Compose ---
DOMAIN=cvbuilder.example.com
ACME_EMAIL=you@example.com
IMAGE_PREFIX=ghcr.io/fawadeqbal/cu-builder
IMAGE_TAG=latest
POSTGRES_USER=cvb
POSTGRES_DB=cvb
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- App ---
APP_URL=https://cvbuilder.example.com
API_CORS_ORIGINS=https://cvbuilder.example.com
LOG_LEVEL=info
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# Comma-separated; these emails become admins when they sign up.
ADMIN_EMAILS=you@example.com
DEV_AUTH=false

# Sign-in with Google / LinkedIn (optional). Redirect URIs:
#   https://<domain>/api/auth/callback/google   https://<domain>/api/auth/callback/linkedin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# AI writing (Claude). Without a key the offline assistant is used (basic rewrites only).
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5

# Job feed. Remotive (remote jobs) works without a key; Jooble and Adzuna switch on when set.
JOOBLE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# Payments (optional until you charge). Webhook URL: https://<domain>/api/v1/billing/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email. smtps://user:password@smtp.example.com:465  (without it, emails are only logged)
SMTP_URL=
EMAIL_FROM="CV Builder <hello@cvbuilder.example.com>"

# Portfolio sites and custom domains. Sites live at <slug>.PORTFOLIO_DOMAIN (wildcard DNS
# *.PORTFOLIO_DOMAIN → this server); without it they are at /p/<slug>. Custom domains point a
# CNAME at CUSTOM_DOMAIN_TARGET (default: the app's host) or A records at CUSTOM_DOMAIN_IPV4.
PORTFOLIO_DOMAIN=
CUSTOM_DOMAIN_TARGET=
CUSTOM_DOMAIN_IPV4=
